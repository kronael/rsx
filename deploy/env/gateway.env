# rsx-gateway — WS ingress. core 1. Binds loopback; nginx fronts it
# with TLS. RSX_GW_JWT_SECRET is NOT here — it lives in secret.env
# (mode 0400), loaded as a second EnvironmentFile by the unit.
RSX_GW_LISTEN=127.0.0.1:8080
RSX_GW_CAST_ADDR=127.0.0.1:9300
RSX_RISK_CAST_ADDR=127.0.0.1:9200
RSX_GW_SEND_ADDR=127.0.0.1:11000
RSX_RISK_GW_SEND_ADDR=127.0.0.1:11200
RSX_GW_WAL_DIR=${PREFIX}/data/rsx/wal
RSX_GW_RL_USER=10
RSX_GW_RL_IP=100
RSX_GW_DATABASE_URL=${DATABASE_URL}
RSX_GW_CORE_ID=1
RSX_GW_HEALTH_ADDR=127.0.0.1:9820
RUST_LOG=info
# Replication TLS (mandatory). deploy.sh provisions snakeoil certs
# into ${PREFIX}/data/rsx/certs; replace with real certs in prod.
RSX_REPL_CERT_PATH=${PREFIX}/data/rsx/certs/cert.pem
RSX_REPL_KEY_PATH=${PREFIX}/data/rsx/certs/key.pem
RSX_REPL_CA_PATH=${PREFIX}/data/rsx/certs/ca.pem
